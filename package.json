{
  "name": "astro-paper",
  "type": "module",
  "version": "5.5.0",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "typecheck": "astro check",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "playwright test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@giscus/react": "^3.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "astro-icon": "^1.2.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "es-toolkit": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.47.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/ph": "^1.2.2",
    "@pagefind/default-ui": "^1.5.2",
    "@playwright/test": "^1.64.0",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "auditConfig": {
      "//ignoreGhsas": "GHSA-ch52-4w7c-c8xp (http-cache-semantics max-stale): no fixed release yet. 4.3.0 only fixes the separate Vary CVE; the advisory range (<=4.2.0) is stale, so audit passing without this entry does not mean it is fixed. Astro uses it only in assets/build/remote.js to cache remote images during the static build; the site serves no HTTP responses through it. Remove this entry once a release with the max-stale fix ships or astro drops the dependency. Tracked in #215.",
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    }
  }
}
