---
import Hr from "@/shared/components/Hr.astro";
import Socials from "@/features/social/components/Socials.astro";
import { Icon } from "astro-icon/components";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <div class="flex items-center gap-4">
      <Socials centered />
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-flex items-center"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <Icon
          name="ph:rss-simple"
          size={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
      <a
        href="/llms.txt"
        class="text-sm hover:text-accent hover:underline focus-visible:underline"
        title="AI 에이전트용 사이트 안내"
      >
        llms.txt
      </a>
    </div>
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span class="flex items-center gap-2">
        <a
          href="/privacy"
          class="hover:text-accent hover:underline focus-visible:underline"
        >
          개인정보 처리방침
        </a>
        <span aria-hidden="true">|</span>
        <a
          href="/contact"
          class="hover:text-accent hover:underline focus-visible:underline"
        >
          연락처
        </a>
      </span>
      {
        import.meta.env.DEV && (
          <>
            <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
            <a
              href="/drafts"
              class="text-accent hover:underline focus-visible:underline"
              title="개발 환경에서만 보이는 Draft 포스트"
            >
              Drafts
            </a>
          </>
        )
      }
    </div>
  </div>
</footer>
