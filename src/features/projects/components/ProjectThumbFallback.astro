---
/**
 * 프로젝트 카드 썸네일의 런타임 폴백.
 *
 * 로드에 실패한 카드 이미지를 ProjectCard가 심어 둔 <template>의 플레이스홀더로
 * 교체해, 이미지가 없는 카드와 같은 모양이 되게 한다. is:inline 스크립트는
 * 인스턴스마다 복제되므로 카드가 아니라 페이지에서 한 번만 렌더한다.
 */
---

<script is:inline>
  (function () {
    // 전역 플래그로 중복 등록 방지 (스크립트가 다시 실행돼도 리스너는 1개씩)
    if (window.__projectThumbFallbackBound) return;
    window.__projectThumbFallbackBound = true;

    const IMAGE_SELECTOR = '[data-project-thumb="image"] img';

    // 요소 참조는 캐시하지 않고 호출 시점의 DOM에서 찾는다 (View Transitions 스왑 대응)
    function fallback(img) {
      const wrapper = img.closest('[data-project-thumb="image"]');
      const template = wrapper?.querySelector(
        "template[data-project-thumb-fallback]"
      );
      if (!wrapper || !template) return;
      wrapper.replaceWith(template.content.cloneNode(true));
    }

    // img의 error는 버블링되지 않으므로 캡처 단계에서 위임한다
    document.addEventListener(
      "error",
      e => {
        if (e.target?.matches?.(IMAGE_SELECTOR)) fallback(e.target);
      },
      true
    );

    // 리스너 등록 전에 이미 실패한 이미지(빠른 실패, 스왑된 새 DOM)를 보정.
    // 아직 로드를 시작하지 않은 lazy 이미지는 complete가 false라 걸리지 않는다
    document.addEventListener("astro:page-load", () => {
      document.querySelectorAll(IMAGE_SELECTOR).forEach(img => {
        if (img.complete && img.naturalWidth === 0) fallback(img);
      });
    });
  })();
</script>
