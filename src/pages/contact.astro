---
import { getEntry, render } from "astro:content";
import ContentPageLayout from "@/layouts/ContentPageLayout.astro";

const entry = await getEntry("pages", "contact");
if (!entry) {
  throw new Error("Content collection entry 'pages/contact' not found");
}
const { Content } = await render(entry);
---

<ContentPageLayout frontmatter={entry.data} sectionId="contact">
  <Content />
</ContentPageLayout>
